[Unit]
Description=Borg weekly check + restore test, job %i
After=network-online.target
OnFailure=backup-failed@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/borg-backup check quick %i
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=24h
# borg rc 1 = warning (e.g. a file changed while being read): record it, do not trigger OnFailure
SuccessExitStatus=1
PrivateTmp=yes
