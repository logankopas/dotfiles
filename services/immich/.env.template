# Immich environment
# Secrets are pulled from Proton Pass vault "homelab" during installation
# Item names match the variable names in curly braces below

UPLOAD_LOCATION=./library
DB_DATA_LOCATION=./postgres
TZ=America/Edmonton
IMMICH_VERSION=v2

# Secrets — these get replaced by values from Proton Pass
DB_PASSWORD=${IMMICH_DB_PASSWORD}
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
