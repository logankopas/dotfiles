#!/bin/sh
# Run by sshd at each login: keep ~/.ssh/agent.sock pointing at this login's forwarded agent, so
# long-running tmux shells (and the architect seat) can reach the key with a fixed path.
if [ -n "$SSH_AUTH_SOCK" ] && [ "$SSH_AUTH_SOCK" != "$HOME/.ssh/agent.sock" ]; then
  ln -sf "$SSH_AUTH_SOCK" "$HOME/.ssh/agent.sock"
fi
